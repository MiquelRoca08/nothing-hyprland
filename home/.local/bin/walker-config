#!/usr/bin/env bash
# Writes ~/.config/walker/config.toml from config.toml.template with its @…@ texts in the interface
# language (walker's config has no translations and walker reads it once, on start). Run by
# walker.service before starting (ExecStartPre), so a restart (walker-restart) picks up a new
# language or a changed template. The generated file is not in git.
source "$HOME/.config/quickshell/i18n/i18n.sh" 2>/dev/null ||
    t() { local s=$1; shift; if (($#)); then printf -- "$s" "$@"; else printf '%s' "$s"; fi; }
dir=$(readlink -f "$HOME/.config/walker")
tpl=$dir/config.toml.template
[[ -f $tpl ]] || exit 0

# A TOML string's content (the translations have no quotes, but just in case) and a sed replacement
esc() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; s=${s//&/\\&}; printf '%s' "${s//|/\\|}"; }
{
    echo "# GENERATED by ~/.local/bin/walker-config from config.toml.template: edit that one."
    sed -e "s|@SEARCH@|$(esc "$(t "Search…")")|g" \
        -e "s|@NO_RESULTS@|$(esc "$(t "No results")")|g" \
        -e "s|@RESTART_WALKER@|$(esc "$(t "Restart walker")")|g" "$tpl"
} >"$dir/config.toml.new" && mv -f "$dir/config.toml.new" "$dir/config.toml"
