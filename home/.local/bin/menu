#!/usr/bin/env bash
# System menu with walker (≈ Omarchy 3.8.4's omarchy-menu).
#   menu                     main menu: searches apps and every entry (without typing,
#                            the sections). If a menu is already open, it closes it.
#   menu <path>              goes straight to a submenu (Escape closes): Actions, Actions/Screenshot,
#                            System… (screenshot and record are short names; the old Spanish names work too)
#   menu run <id>            runs an entry (used by the elephant menus)
#   menu --entries           prints the entry table in the interface language (read by the elephant menus)
#   menu --all-entries       the table in English, without removing hidden entries (read by Settings → Menu)
#   menu --from-main <path>  submenu opened from the main one: Escape goes back to it
#
# The entries come from one table (ENTRIES): the submenus and the main menu's search
# (~/.config/elephant/menus/system*.lua) use the same one. Its paths and texts are in English and
# are also the identifiers of hidden entries and of the order in settings.json; they are shown in the
# interface language (t, ~/.config/quickshell/i18n/i18n.sh).

source "$HOME/.config/quickshell/i18n/i18n.sh" 2>/dev/null || {
    declare -A I18N=()
    t() { local s=$1; shift; if (($#)); then printf -- "$s" "$@"; else printf '%s' "$s"; fi; }
}

# path|icon|text|target — a «>Path» target opens that submenu; otherwise it is an id for «run»
ENTRIES=$(cat <<'END'
|󰀻|Apps|apps
|󰧑|Learn|>Learn
|󱓞|Actions|>Actions
|󰉦|Style|>Style
|󰒓|Settings|settings
|󰉉|Install|>Install
|󰭌|Remove|>Remove
|󰚰|Update|>Update
|󰋽|About|about
|󰌢|System|>System
Learn|󰌌|Keybinds|keybinds
Learn|󰈙|Hyprland|wiki-hyprland
Learn|󰣇|Arch Wiki|wiki-arch
Learn|󰈙|Quickshell|wiki-quickshell
Actions|󰄀|Screenshot|>Actions/Screenshot
Actions|󰕧|Record|>Actions/Record
Actions|󰂛|Do Not Disturb|dnd
Actions|󱫖|Idle lock|idle
Actions|󰍹|Laptop screen|laptop-screen
Actions/Screenshot|󰍹|Screen|screenshot-screen
Actions/Screenshot|󰩭|Region|screenshot-region
Actions/Screenshot|󰖯|Window|screenshot-window
Actions/Screenshot|󰴑|Text (OCR)|screenshot-text
Actions/Screenshot|󰃉|Color|color
Actions/Record|󰝟|No audio|record
Actions/Record|󰕾|With system audio|record-audio
Actions/Record|󰍬|With audio and mic|record-mic
Style|󰸉|Wallpaper|wallpaper
Style|󰏘|Appearance|appearance
Install|󰣇|Package|install-package
Install|󰏖|AUR|install-aur
Install|󰏓|Flatpak|install-flatpak
Install|󰖟|WebApp|install-webapp
Install|󰆍|TUI|install-tui
Remove|󰣇|Package|remove-package
Remove|󰏓|Flatpak|remove-flatpak
Remove|󰖟|WebApp|remove-webapp
Remove|󰆍|TUI|remove-tui
Update|󰚰|System (with AUR)|update
Update|󰣇|Repos only|update-repos
Update|󰍛|Firmware|firmware
Update|󰑓|Restart walker|restart-walker
Update|󰑓|Restart shell|restart-shell
System|󰌾|Lock|lock
System|󰒲|Suspend|suspend
System|󰍃|Log out|logout
System|󰜉|Reboot|reboot
System|󰐥|Power off|poweroff
END
)

# Entries that need a program (target → command): without it they are left out of the menu, its
# search and Settings → Menu (the installer's features module can remove these programs). The
# entries of a submenu left out go with it; opening it directly (menu record) just says so.
declare -A REQUIRES=(
    [screenshot-text]=tesseract
    [">Actions/Record"]=gpu-screen-recorder [record]=gpu-screen-recorder
    [record-audio]=gpu-screen-recorder [record-mic]=gpu-screen-recorder
    [install-flatpak]=flatpak [remove-flatpak]=flatpak
    [firmware]=fwupdmgr
)
declare -A UNAVAILABLE=()   # submenu path → the missing program
for d in "${!REQUIRES[@]}"; do
    [[ $d == \>* ]] && ! command -v "${REQUIRES[$d]}" >/dev/null && UNAVAILABLE[${d#>}]=${REQUIRES[$d]}
done
ENTRIES=$(while IFS='|' read -r r i x d; do
    need=${REQUIRES[$d]:-}
    [[ -n $need ]] && ! command -v "$need" >/dev/null && continue
    [[ -n $r && -n ${UNAVAILABLE[$r]:-} ]] && continue
    printf '%s|%s|%s|%s\n' "$r" "$i" "$x" "$d"
done <<<"$ENTRIES")

# Customization (Settings → Personalization → QuickShell → Menu, in settings.json): hidden entries
# and sections («Section» or «Section/Entry»; hiding a section hides everything inside it,
# search included), the order of the main menu sections and custom entries
# ({ path, icon, text, command }, run by «run custom:N»)
SETTINGS="$HOME/.config/quickshell/settings.json"
ALL=$ENTRIES
if command -v jq >/dev/null && [[ -f $SETTINGS ]]; then
    # (.ruta/.icono/.texto: field names before the move to English, until the shell migrates them)
    # One jq for the three lists (each jq costs ~5 ms), separated by NUL
    { IFS= read -r -d '' custom; IFS= read -r -d '' hidden; IFS= read -r -d '' order; } < <(jq -j '
        ([(.menuCustom // []) | to_entries[] | (.value.text // .value.texto) as $t | select($t != null and $t != "")
         | "\(.value.path // .value.ruta // "")|\(.value.icon // .value.icono // "󰘳")|\($t | gsub("[|]"; "/"))|custom:\(.key)"] | join("\n")),
        "\u0000", ((.menuHidden // []) | join("\n")), "\u0000", ((.menuOrder // []) | join("\n")), "\u0000"' "$SETTINGS" 2>/dev/null)
    [[ -n $custom ]] && ALL+=$'\n'"$custom"
    ENTRIES=$(awk -F'|' -v hid="$hidden" -v ord="$order" '
        BEGIN { n = split(hid, o, "\n"); for (i = 1; i <= n; i++) if (o[i] != "") h[o[i]] = 1
                m = split(ord, r, "\n"); for (i = 1; i <= m; i++) if (r[i] != "") pos[r[i]] = i }
        # Hidden itself, or some section of its path
        function is_hidden(path, text,   p) {
            if ((path == "" ? text : path "/" text) in h) return 1
            for (p = path; p != ""; ) { if (p in h) return 1; if (index(p, "/")) sub(/\/[^\/]*$/, "", p); else p = "" }
            return 0 }
        !is_hidden($1, $3) { if ($1 == "") { top[++t] = $0; rank[t] = ($3 in pos) ? pos[$3] : 1000 + t } else rest[++q] = $0 }
        END {   # sections in the chosen order; those not in it go after, in their own order
            for (i = 1; i <= t; i++) idx[i] = i
            for (i = 2; i <= t; i++) for (j = i; j > 1 && rank[idx[j - 1]] > rank[idx[j]]; j--) { x = idx[j]; idx[j] = idx[j - 1]; idx[j - 1] = x }
            for (i = 1; i <= t; i++) print top[idx[i]]
            for (i = 1; i <= q; i++) print rest[i] }' <<<"$ALL")
fi

# Column 5: the text in the interface language (what walker shows and returns). The I18N table
# is read directly, not through $(t …): one subshell per entry made «menu --entries», which the
# elephant menus run on every keystroke, take ~135 ms
ENTRIES=$(while IFS='|' read -r r i x d; do printf '%s|%s|%s|%s|%s\n' "$r" "$i" "$x" "$d" "${I18N[$x]:-$x}"; done <<<"$ENTRIES")

# A path in the interface language (Actions/Screenshot → Acciones/Captura), into $view
path_view() {
    local IFS=/ p out=()
    for p in $1; do out+=("${I18N[$p]:-$p}"); done
    view="${out[*]}"
}

BACK_EXITS=false # true when entering a submenu directly (from a bind)

# Signal for the open menu to end completely (SUPER+SPACE with the menu open)
CLOSE_FLAG="${XDG_RUNTIME_DIR:-/tmp}/menu-close"

# Menu width from the longest text (minimum 295 px): ~10 px per character plus margins
width_for() { local n; n=$(echo -e "$1" | wc -L); echo $((n * 10 + 100 > 295 ? n * 10 + 100 : 295)); }

# menu <prompt> <options separated by \n>. No search field: while it is open, Hyprland's «menu»
# submap is on, where Backspace closes the menu (menu-back) and goes back like Escape.
# It is cleared at the end, so whatever opens next gets a normal Backspace.
menu() {
    hyprctl dispatch 'hl.dsp.submap("menu")' >/dev/null
    echo -e "$2" | walker-launch --dmenu --nosearch --width "$(width_for "$2\n$1…")" \
        --minheight 1 --maxheight 630 -p "$1…" 2>/dev/null
    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null
    # menu() runs inside $(…): «exit» would only leave the subshell, so the whole script
    # is ended ($$ is still the script's PID)
    if [[ -e $CLOSE_FLAG ]]; then rm -f "$CLOSE_FLAG"; kill $$; fi
}

# Runs a command in a floating terminal and waits for a key when it ends
terminal() {
    # 130 = cancelled (Escape in fzf, Ctrl+C): close without waiting
    # Extra keystrokes are discarded before waiting, so they do not close it
    setsid alacritty --class menu-terminal --title "$1" -e bash -c \
        "$2; e=\$?; ((e == 130)) && exit; echo; while read -t 0.05 -n 1 -s; do :; done; read -n 1 -s -r -p '$(t "Done. Press a key to close…")'" >/dev/null 2>&1 &
}

# ~/.config/quickshell/scripts/update.sh: arch-update --menu, which waits for its «Close» button
update() {
    setsid alacritty --class menu-terminal --title "$(t Update)" \
        -e "$HOME/.config/quickshell/scripts/update.sh" "$@" >/dev/null 2>&1 &
}

notify() { notify-send -u low "$@"; }

# Main menu: walker with the «menu» provider set (config.toml): without typing it shows
# the sections (menus:system); typing searches every entry (menus:systemsearch) and
# the apps. If it is already open, walker closes it (close_when_open).
main_menu() {
    # 44 px per section (that is the row height: .item-box in walker/themes/nothing/style.css) plus 6
    # of slack, so the last one is not clipped at fractional scale (1.8): just tall enough to show
    # them all without scrolling
    local n height
    n=$(awk -F'|' '$1 == ""' <<<"$ENTRIES" | wc -l)
    height=$((n * 44 < 176 ? 182 : n * 44 + 6))
    exec walker-launch -s menu -p "$(t "Search apps and options…")" --minheight "$height" --maxheight "$height"
}

# Entries of a path, as «icon  text» (one per line)
options_of() { awk -F'|' -v r="$1" '$1 == r { printf "%s  %s\n", $2, $5 }' <<<"$ENTRIES"; }

# Target of the entry shown as <text> in path <path>
target_of() { awk -F'|' -v r="$1" -v t="$2" '$1 == r && $5 == t { print $4; exit }' <<<"$ENTRIES"; }

# Escape (or Backspace) in a submenu: to its parent; from a top-level one, to the main menu
go_back() {
    [[ $BACK_EXITS == true ]] && exit 0
    if [[ $1 == */* ]]; then show "${1%/*}"; else main_menu; fi
}

show() {
    local path=$1 chosen text target
    if [[ -n ${UNAVAILABLE[$path]:-} ]]; then
        notify "$(t "%s is not installed" "${UNAVAILABLE[$path]}")" "$(t "Install it with ./install.sh features and packages")"
        exit 0
    fi
    # If already recording, the «Record» entry stops it
    if [[ $path == Actions/Record ]] && record --stop; then exit 0; fi
    chosen=$(menu "$(t "${path##*/}")" "$(options_of "$path")")
    [[ -n $chosen ]] || { go_back "$path"; return; }
    text=${chosen#*  }
    target=$(target_of "$path" "$text")
    if [[ $target == \>* ]]; then show "${target#>}"; else run "$target"; fi
}

run() {
    case $1 in
    apps) exec walker-launch -p "$(t "Open…")" ;;
    settings) qs ipc call settings open "" ;;
    about) terminal "$(t About)" "fastfetch" ;;
    keybinds) menu-keybinds ;;
    custom:*)
        local cmd
        cmd=$(jq -r ".menuCustom[${1#custom:}] | .command // .comando // empty" "$SETTINGS" 2>/dev/null)
        [[ -n $cmd ]] && setsid -f sh -c "$cmd" >/dev/null 2>&1 ;;
    wiki-hyprland) xdg-open https://wiki.hypr.land/ ;;
    wiki-arch) xdg-open https://wiki.archlinux.org/ ;;
    wiki-quickshell) xdg-open https://quickshell.org/docs/ ;;
    dnd)
        if [[ $(qs ipc call notifications dnd) == true ]]; then notify "$(t "Do Not Disturb on")"; else notify "$(t "Do Not Disturb off")"; fi ;;
    idle)
        if pkill -x hypridle; then
            notify "$(t "Idle lock off")" "$(t "The screen will not lock or turn off by itself")"
        else
            setsid hypridle >/dev/null 2>&1 &
            notify "$(t "Idle lock on")"
        fi ;;
    laptop-screen) hyprctl dispatch 'hl.dsp.dpms({ action = "toggle", monitor = "eDP-1" })' >/dev/null ;;
    screenshot-screen) screenshot screen ;;
    screenshot-region) screenshot region ;;
    screenshot-window) screenshot window ;;
    screenshot-text) screenshot text ;;
    color) pkill hyprpicker || hyprpicker -a ;;
    record) record --stop || record ;;
    record-audio) record --stop || record --audio ;;
    record-mic) record --stop || record --audio --mic ;;
    wallpaper) walker-launch -m menus:wallpapers -p "$(t "Wallpaper…")" ;;
    appearance) qs ipc call settings open themes ;;
    install-package) terminal "$(t "Install packages")" "packages repos" ;;
    install-aur) terminal "$(t "Install from the AUR")" "packages aur" ;;
    install-flatpak) terminal "$(t "Install Flatpak")" "packages flatpak" ;;
    install-webapp) webapp create ;;
    install-tui) tui create ;;
    remove-package) terminal "$(t "Remove packages")" "packages remove" ;;
    remove-flatpak) terminal "$(t "Remove Flatpak")" "packages remove-flatpak" ;;
    remove-webapp) webapp remove ;;
    remove-tui) tui remove ;;
    update) update ;;
    update-repos) update --no-aur ;;
    firmware) terminal "Firmware" "fwupdmgr refresh && fwupdmgr update" ;;
    restart-walker) walker-restart && notify "$(t "Walker restarted")" ;;
    restart-shell) pkill -x qs; hyprctl dispatch 'hl.dsp.exec_cmd("qs")' >/dev/null ;;
    lock) lock-screen ;;
    suspend) systemctl suspend ;;
    logout) hyprctl dispatch 'hl.dsp.exit()' ;;
    reboot) systemctl reboot ;;
    poweroff) systemctl poweroff ;;
    *) echo "menu: unknown option: $1" >&2; exit 1 ;;
    esac
}

# Short name or path → table path (screenshot → Actions/Screenshot). The old Spanish names too
path_of() {
    case ${1,,} in
    screenshot | captura | acciones/captura) echo Actions/Screenshot ;;
    record | grabar | acciones/grabar) echo Actions/Record ;;
    acciones) echo Actions ;;
    aprender) echo Learn ;;
    estilo) echo Style ;;
    instalar) echo Install ;;
    quitar) echo Remove ;;
    actualizar) echo Update ;;
    sistema) echo System ;;
    *) awk -F'|' -v r="${1,,}" 'tolower($1) == r { print $1; exit }' <<<"$ENTRIES" ;;
    esac
}

case ${1:-} in
--entries)
    while IFS='|' read -r r i x d v; do path_view "$r"; printf '%s|%s|%s|%s\n' "$view" "$i" "$v" "$d"; done <<<"$ENTRIES"
    exit 0 ;;
--all-entries) echo "$ALL"; exit 0 ;;
run) run "$2"; exit ;;
esac

# The same bind closes the menu if it is open (completely, without going back)
if pgrep -f "walker.*--dmenu" >/dev/null; then
    touch "$CLOSE_FLAG"
    walker --close >/dev/null 2>&1
    exit 0
fi
rm -f "$CLOSE_FLAG"

# In case the script ends unexpectedly with the submap on
trap 'hyprctl dispatch '"'"'hl.dsp.submap("reset")'"'"' >/dev/null' EXIT

case ${1:-} in
"") main_menu ;;
--from-main)
    # walker has just closed: without this pause, it sometimes does not show the next menu
    sleep 0.3
    show "$2" ;;
*)
    BACK_EXITS=true
    r=$(path_of "$1")
    [[ -n $r ]] || { echo "menu: unknown submenu: $1" >&2; exit 1; }
    show "$r" ;;
esac
