#!/usr/bin/env bash
# TUIs: a terminal program with its icon in the launcher (≈ Omarchy 3.8.4's omarchy-tui-install and
# omarchy-tui-remove). It opens in Alacritty with class TUI.float (floating and centered, rule in
# conf/rules.lua) or TUI.tile (tiled). Launchers are marked with X-Created-By=tui (older ones,
# with X-Creado-Por, still count).
#   tui create [name command floating|tiled [icon]]   without arguments it asks with walker
#   tui remove [name]                                 without arguments it lets you pick
source "$HOME/.config/quickshell/i18n/i18n.sh" 2>/dev/null ||
    t() { local s=$1; shift; if (($#)); then printf -- "$s" "$@"; else printf '%s' "$s"; fi; }
APPS="$HOME/.local/share/applications"
ICONS="$APPS/icons"
MARK='^X-(Created-By|Creado-Por)=tui$'

notify() { notify-send -u low "$@"; }

create() {
    local name=$1 command=$2 style=$3 icon=$4
    if [[ -z $name ]]; then
        name=$(menu-input "$(t "TUI name")") || exit 0
        [[ -n $name ]] || exit 0
        command=$(menu-input "$(t "Command (e.g. btop or lazygit)")") || exit 0
        [[ -n $command ]] || exit 0
        style=$(menu-select "$(t Window)" "$(t Floating)" "$(t Tiled)") || exit 0
        [[ $style == "$(t Tiled)" ]] && style=tiled || style=floating
        icon=$(menu-input "$(t "URL of a PNG/SVG icon (empty = terminal icon)")")
    fi
    [[ -n $name && -n $command ]] || { echo "The name or the command is missing" >&2; exit 1; }
    local class=TUI.float
    [[ $style == tiled ]] && class=TUI.tile

    local png=utilities-terminal
    if [[ -n $icon ]]; then
        if [[ -f $icon ]]; then
            png=$icon
        else
            mkdir -p "$ICONS"
            if curl -fsSL -o "$ICONS/$name.png" "$icon" && [[ -s $ICONS/$name.png ]]; then
                png="$ICONS/$name.png"
            else
                rm -f "$ICONS/$name.png"
                notify "$(t "Could not download the icon")" "$(t "The terminal one is used")"
            fi
        fi
    fi

    cat >"$APPS/$name.desktop" <<EOF
[Desktop Entry]
Version=1.0
Name=$name
Comment=$name (TUI)
Exec=alacritty --class $class -e $command
Terminal=false
Type=Application
Icon=$png
StartupNotify=true
X-Created-By=tui
EOF
    chmod +x "$APPS/$name.desktop"
    notify "$(t "TUI created: %s" "$name")" "$(t "Open it from the launcher (SUPER+ALT+SPACE)")"
}

remove() {
    local name=$1 list
    if [[ -z $name ]]; then
        mapfile -t list < <(grep -lE "$MARK" "$APPS"/*.desktop 2>/dev/null | xargs -r -n1 basename | sed 's/\.desktop$//' | sort)
        ((${#list[@]})) || { notify "$(t "No TUI has been created")"; exit 0; }
        name=$(menu-select "$(t "Remove TUI")" "${list[@]}") || exit 0
        [[ -n $name ]] || exit 0
    fi
    grep -qE "$MARK" "$APPS/$name.desktop" 2>/dev/null || { notify "$(t "«%s» is not a TUI" "$name")"; exit 1; }
    rm -f "$APPS/$name.desktop" "$ICONS/$name.png"
    notify "$(t "TUI removed: %s" "$name")"
}

case ${1:-} in
create) create "${@:2}" ;;
remove) remove "${@:2}" ;;
*) echo "usage: tui create [name command floating|tiled [icon]] | remove [name]" >&2; exit 1 ;;
esac
