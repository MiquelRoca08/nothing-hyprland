#!/usr/bin/env bash
# TUIs: a terminal program with its icon in the launcher (≈ Omarchy 3.8.4's omarchy-tui-install and
# omarchy-tui-remove). It opens in Alacritty with class TUI.float (floating and centered, rule in
# conf/rules.lua) or TUI.tile (tiled).
#   tui crear [nombre comando flotante|mosaico [icono]]   without arguments it asks with walker
#   tui quitar [nombre]                                   without arguments it lets you pick
source "$HOME/.config/quickshell/i18n/i18n.sh" 2>/dev/null ||
    t() { local s=$1; shift; if (($#)); then printf -- "$s" "$@"; else printf '%s' "$s"; fi; }
APPS="$HOME/.local/share/applications"
ICONOS="$APPS/icons"

avisar() { notify-send -u low "$@"; }

crear() {
    local nombre=$1 comando=$2 estilo=$3 icono=$4
    if [[ -z $nombre ]]; then
        nombre=$(menu-input "$(t "TUI name")") || exit 0
        [[ -n $nombre ]] || exit 0
        comando=$(menu-input "$(t "Command (e.g. btop or lazygit)")") || exit 0
        [[ -n $comando ]] || exit 0
        estilo=$(menu-select "$(t Window)" "$(t Floating)" "$(t Tiled)") || exit 0
        [[ $estilo == "$(t Tiled)" ]] && estilo=mosaico || estilo=flotante
        icono=$(menu-input "$(t "URL of a PNG/SVG icon (empty = terminal icon)")")
    fi
    [[ -n $nombre && -n $comando ]] || { echo "The name or the command is missing" >&2; exit 1; }
    local clase=TUI.float
    [[ $estilo == mosaico ]] && clase=TUI.tile

    local png=utilities-terminal
    if [[ -n $icono ]]; then
        if [[ -f $icono ]]; then
            png=$icono
        else
            mkdir -p "$ICONOS"
            if curl -fsSL -o "$ICONOS/$nombre.png" "$icono" && [[ -s $ICONOS/$nombre.png ]]; then
                png="$ICONOS/$nombre.png"
            else
                rm -f "$ICONOS/$nombre.png"
                avisar "$(t "Could not download the icon")" "$(t "The terminal one is used")"
            fi
        fi
    fi

    cat >"$APPS/$nombre.desktop" <<EOF
[Desktop Entry]
Version=1.0
Name=$nombre
Comment=$nombre (TUI)
Exec=alacritty --class $clase -e $comando
Terminal=false
Type=Application
Icon=$png
StartupNotify=true
X-Creado-Por=tui
EOF
    chmod +x "$APPS/$nombre.desktop"
    avisar "$(t "TUI created: %s" "$nombre")" "$(t "Open it from the launcher (SUPER+ALT+SPACE)")"
}

quitar() {
    local nombre=$1
    if [[ -z $nombre ]]; then
        mapfile -t lista < <(grep -l '^X-Creado-Por=tui' "$APPS"/*.desktop 2>/dev/null | xargs -r -n1 basename | sed 's/\.desktop$//' | sort)
        ((${#lista[@]})) || { avisar "$(t "No TUI has been created")"; exit 0; }
        nombre=$(menu-select "$(t "Remove TUI")" "${lista[@]}") || exit 0
        [[ -n $nombre ]] || exit 0
    fi
    grep -q '^X-Creado-Por=tui' "$APPS/$nombre.desktop" 2>/dev/null || { avisar "$(t "«%s» is not a TUI" "$nombre")"; exit 1; }
    rm -f "$APPS/$nombre.desktop" "$ICONOS/$nombre.png"
    avisar "$(t "TUI removed: %s" "$nombre")"
}

case ${1:-} in
crear) crear "${@:2}" ;;
quitar) quitar "${@:2}" ;;
*) echo "usage: tui crear [nombre comando flotante|mosaico [icono]] | quitar [nombre]" >&2; exit 1 ;;
esac
