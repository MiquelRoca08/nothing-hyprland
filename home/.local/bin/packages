#!/usr/bin/env bash
# Install and remove packages with fzf in the terminal (≈ Omarchy 3.8.4's omarchy-pkg-install,
# omarchy-pkg-aur-install and omarchy-pkg-remove), plus Flatpak (Flathub). The system menu opens it
# in a floating terminal.
#   packages repos | aur | flatpak        install
#   packages remove | remove-flatpak      remove
# Tab marks several; below, the package description (alt-p hides it, alt-j/k scrolls it).
source "$HOME/.config/quickshell/i18n/i18n.sh" 2>/dev/null ||
    t() { local s=$1; shift; if (($#)); then printf -- "$s" "$@"; else printf '%s' "$s"; fi; }

# White and greys like the rest of the system; red only for removing
COLORS='fg:#b0b0b0,fg+:#ffffff,bg+:#161616,hl:#ffffff,hl+:#ffffff,info:#6e6e6e,prompt:#ffffff,pointer:#ffffff,marker:#ffffff,spinner:#6e6e6e,header:#6e6e6e,border:#2e2e2e,label:#6e6e6e'
COLORS_REMOVE="$COLORS,pointer:#d71921,marker:#d71921"

# pick <preview> <label> [colors] [more fzf options…] (list on stdin)
pick() {
    local preview=$1 label=$2 colors=${3:-$COLORS}
    shift 3
    fzf --multi --reverse --prompt '  ' \
        --preview "$preview" \
        --preview-label "$label" --preview-label-pos bottom \
        --preview-window 'down:65%:wrap' \
        --bind 'alt-p:toggle-preview' \
        --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up' \
        --bind 'alt-k:preview-up,alt-j:preview-down' \
        --color "$colors" "$@"
}

# Asks for the password once and keeps it alive while running (≈ omarchy-sudo-keepalive)
sudo_keepalive() {
    sudo -v || exit 1
    while true; do sudo -n true; sleep 60; done 2>/dev/null &
    trap "kill $! 2>/dev/null" EXIT
}

HELP="$(t "alt-p: description · alt-j/k: scroll · tab: select several")"

case ${1:-} in
repos)
    chosen=$(pacman -Slq | sort -u | pick 'pacman -Sii {1}' "$HELP" "$COLORS" --header "$(t "Install (repos)")")
    [[ -n $chosen ]] || exit 130
    sudo_keepalive
    echo "$chosen" | xargs sudo pacman -S --needed --noconfirm
    ;;
aur)
    chosen=$(yay -Slqa | pick 'yay -Siia {1}' "$HELP · alt-b/B: PKGBUILD / info" "$COLORS" \
        --header "$(t "Install (AUR)")" \
        --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5' \
        --bind 'alt-B:change-preview:yay -Siia {1}')
    [[ -n $chosen ]] || exit 130
    sudo_keepalive
    echo "$chosen" | sed 's|^|aur/|' | xargs yay -S --noconfirm
    ;;
flatpak)
    echo "$(t "Loading the Flathub list…")"
    chosen=$(flatpak remote-ls flathub --app --columns=application,name |
        pick 'flatpak remote-info flathub {1}' "$HELP" "$COLORS" \
            --header "$(t "Install (Flatpak)")" --delimiter '\t' --with-nth 2,1 --accept-nth 1)
    [[ -n $chosen ]] || exit 130
    sudo_keepalive
    echo "$chosen" | xargs sudo flatpak install -y --noninteractive flathub
    ;;
remove)
    # Only explicitly installed ones (not dependencies)
    chosen=$(yay -Qqe | pick 'yay -Qi {1}' "$HELP" "$COLORS_REMOVE" --header "$(t "Remove packages")")
    [[ -n $chosen ]] || exit 130
    sudo_keepalive
    echo "$chosen" | xargs sudo pacman -Rns --noconfirm
    ;;
remove-flatpak)
    list=$(flatpak list --app --columns=application,name)
    [[ -n $list ]] || { echo "$(t "No Flatpak app is installed.")"; exit 0; }
    chosen=$(echo "$list" | pick 'flatpak info {1}' "$HELP" "$COLORS_REMOVE" \
        --header "$(t "Remove (Flatpak)")" --delimiter '\t' --with-nth 2,1 --accept-nth 1)
    [[ -n $chosen ]] || exit 130
    sudo_keepalive
    echo "$chosen" | xargs sudo flatpak uninstall -y --noninteractive
    sudo flatpak uninstall -y --noninteractive --unused
    ;;
*)
    echo "usage: packages repos|aur|flatpak|remove|remove-flatpak" >&2
    exit 1
    ;;
esac
