#!/usr/bin/env bash
# Screenshots (≈ omarchy-capture-screenshot + omarchy-capture-text-extraction).
#   screenshot screen   the focused monitor
#   screenshot region   region with the mouse (a single click = the window or screen below)
#   screenshot window   pick a window on the current workspace
#   screenshot text     region → OCR to the clipboard (English plus every other installed
#                       tesseract language: tesseract-data-<lang>)
# The image is saved to ~/Pictures/Screenshots and copied to the clipboard, and the notification opens
# satty to annotate it. While selecting, the screen is frozen with hyprpicker.
source "$HOME/.config/quickshell/i18n/i18n.sh" 2>/dev/null ||
    t() { local s=$1; shift; if (($#)); then printf -- "$s" "$@"; else printf '%s' "$s"; fi; }
DIR="$HOME/Pictures/Screenshots"
mkdir -p "$DIR"

# A second press of the bind while selecting cancels
pkill slurp && exit 0

# x,y WidthxHeight of a monitor, in logical pixels (accounts for scale and rotation)
JQ_GEO='
  def geo: (.width / .scale | floor) as $w | (.height / .scale | floor) as $h |
    if .transform == 1 or .transform == 3 then "\(.x),\(.y) \($h)x\($w)" else "\(.x),\(.y) \($w)x\($h)" end;'

# Monitors and windows of the visible workspace (so slurp offers them)
targets() {
    local ws
    ws=$(hyprctl monitors -j | jq -r '.[] | select(.focused) | .activeWorkspace.id')
    hyprctl monitors -j | jq -r --arg ws "$ws" "$JQ_GEO .[] | select(.activeWorkspace.id == (\$ws | tonumber)) | geo"
    hyprctl clients -j | jq -r --arg ws "$ws" '.[] | select(.workspace.id == ($ws | tonumber)) | "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
}

freeze() {
    hyprpicker -r -z >/dev/null 2>&1 &
    PID=$!
    sleep .1
}
# hyprpicker stays alive until after grim, to capture the frozen image
trap '[[ -n $PID ]] && kill $PID 2>/dev/null' EXIT

mode=${1:-region}
case $mode in
screen)
    SEL=$(hyprctl monitors -j | jq -r "$JQ_GEO .[] | select(.focused) | geo") ;;
window)
    freeze
    SEL=$(targets | slurp -r 2>/dev/null) ;;
region)
    RECTS=$(targets)
    freeze
    SEL=$(echo "$RECTS" | slurp 2>/dev/null)
    # A single click (tiny region) = the window or screen below
    if [[ $SEL =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] && ((BASH_REMATCH[3] * BASH_REMATCH[4] < 20)); then
        cx=${BASH_REMATCH[1]} cy=${BASH_REMATCH[2]}
        while IFS= read -r r; do
            [[ $r =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || continue
            if ((cx >= BASH_REMATCH[1] && cx < BASH_REMATCH[1] + BASH_REMATCH[3] &&
                cy >= BASH_REMATCH[2] && cy < BASH_REMATCH[2] + BASH_REMATCH[4])); then
                SEL=$r
                break
            fi
        done <<<"$RECTS"
    fi ;;
text)
    freeze
    SEL=$(slurp 2>/dev/null)
    [[ -n $SEL ]] || exit 0
    # English plus any other installed language (tesseract-data-<lang>)
    langs=$(tesseract --list-langs 2>/dev/null | grep -vE '^(List|osd$|eng$)' | paste -sd+)
    TEXT=$(grim -g "$SEL" - | tesseract stdin stdout --oem 1 --psm 6 -l "eng${langs:++$langs}" --dpi 300 \
        -c preserve_interword_spaces=1 2>/dev/null) || exit 1
    [[ -n $TEXT ]] || { notify-send -u low "$(t "No text found")"; exit 1; }
    printf "%s" "$TEXT" | wl-copy
    notify-send -u low "󰴑  $(t "Text copied to the clipboard")"
    exit 0 ;;
*)
    echo "usage: screenshot screen|region|window|text" >&2
    exit 1 ;;
esac

[[ -n $SEL ]] || exit 0

FILE="$DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
grim -g "$SEL" "$FILE" || exit 1
wl-copy <"$FILE"

# Notification with a thumbnail; clicking it opens satty to annotate (Enter copies and saves)
(
    action=$(notify-send "$(t "Screenshot copied and saved")" "$(t "Click here to annotate it")" -t 10000 \
        -i "$FILE" -A "default=$(t Annotate)")
    [[ $action == default ]] && satty --filename "$FILE" --output-filename "$FILE" \
        --actions-on-enter save-to-clipboard --save-after-copy --copy-command wl-copy
) >/dev/null 2>&1 &
