#!/usr/bin/env bash
# Locks the session with the shell's lock screen (quickshell/LockScreen.qml).
# Used by hypridle (lock_cmd), autostart, the power menu, Settings and the system
# menu. If the shell does not answer within a few seconds (not running, or its config
# has an error), it locks with hyprlock so the session is never left open.

# "Session locked" mark: if the shell is starting, it locks as soon as it loads
touch "$XDG_RUNTIME_DIR/qs-locked"

for _ in $(seq 20); do
    if qs ipc call lock lock >/dev/null 2>&1 &&
        [[ $(qs ipc call lock isLocked 2>/dev/null) == true ]]; then
        exit 0
    fi
    sleep 0.25
done

pidof hyprlock >/dev/null && exit 0
# hyprlock in the interface language: a copy of hyprlock.conf with the placeholder translated, and
# the system LANG for the date (Hyprland's environment keeps the one of the login)
source "$HOME/.config/quickshell/i18n/i18n.sh" 2>/dev/null || t() { printf '%s' "$1"; }
lang=$(sed -n 's/^LANG=//p' /etc/locale.conf 2>/dev/null | tr -d '"')
[[ -n $lang ]] && export LANG=$lang LC_TIME=$lang
conf="$XDG_RUNTIME_DIR/hyprlock.conf"
if sed "s|^\([[:space:]]*placeholder_text[[:space:]]*=\).*|\1 $(t PASSWORD)|" \
        "$HOME/.config/hypr/hyprlock.conf" >"$conf" 2>/dev/null; then
    exec hyprlock -c "$conf"
fi
exec hyprlock
