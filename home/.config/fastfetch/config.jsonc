// fastfetch with the reds of the terminal theme (alacritty.toml): without this it paints the Arch
// logo and the labels in cyan, which is not the theme's accent. Color names are the ones
// of the ANSI palette: "red" = Nothing red (#d71921), "blue" = coral red (#e0454c).
// "modules" is the default list (`fastfetch --config none --gen-config <file>`): with a
// config file without "modules", fastfetch shows none of them, only the logo.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "color": { "1": "red", "2": "red" }
    },
    "display": {
        "color": { "keys": "blue", "title": "red" }
    },
    "modules": [
        "title", "separator", "os", "host", "kernel", "uptime", "packages", "shell", "display",
        "de", "wm", "wmtheme", "theme", "icons", "font", "cursor", "terminal", "terminalfont",
        "cpu", "gpu", "memory", "swap", "disk", "localip", "battery", "poweradapter", "locale",
        "break", "colors"
    ]
}
