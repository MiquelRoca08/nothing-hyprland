# Walker — only what differs from /etc/xdg/walker/config.toml (walker merges it with
# its defaults). Edit config.toml.template: ~/.local/bin/walker-config writes config.toml from it
# (not in git) with the @…@ texts in the interface language, every time the walker service starts. Prefixes: the usual ones (; > / . ! % = @ : $), untouched.
force_keyboard_focus = true # keyboard focus stays in walker
selection_wrap = true       # wraps from the last entry to the first
hide_action_hints = true    # no hint bar at the bottom
theme = "nothing"           # themes/nothing/

[placeholders]
"default" = { input = "@SEARCH@", list = "@NO_RESULTS@" }

[keybinds]
quick_activate = [] # no F1–F4

[columns]
symbols = 1 # emoji as a list, not a grid

[providers]
max_results = 256
default = ["desktopapplications", "calc", "websearch"]
empty = ["desktopapplications"]

# Shown if elephant does not answer
[[emergencies]]
text = "@RESTART_WALKER@"
command = "walker-restart"


# System menu (SUPER+SPACE, «menu»): without typing, the sections; while typing, every
# entry of the menu and its submenus (elephant menus system*.lua) and the apps
[providers.sets.menu]
default = ["menus:systemsearch", "desktopapplications"]
empty = ["menus:system"]
