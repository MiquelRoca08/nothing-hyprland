// Plymouth theme «nothing» (disabled: docs/SYSTEM.md): the logo (logo.png, generated by scripts/logo-arranque.py)
// centered on black, on boot and shutdown. Drawn at actual size in the same place as the UKI splash
// (systemd-stub also centers it at actual size), so the handover is not noticeable. It is only
// scaled down if the screen is narrower than the logo. No text or progress bar.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

logo.image = Image("logo.png");
logo.sprite = Sprite();

fun colocar() {
    w = Window.GetWidth();
    h = Window.GetHeight();
    img = logo.image;
    if (img.GetWidth() > w * 0.9)
        img = img.Scale(Math.Int(w * 0.9), Math.Int(img.GetHeight() * w * 0.9 / img.GetWidth()));
    logo.sprite.SetImage(img);
    logo.sprite.SetX(Window.GetX() + Math.Int((w - img.GetWidth()) / 2));
    logo.sprite.SetY(Window.GetY() + Math.Int((h - img.GetHeight()) / 2));
    logo.sprite.SetZ(10);
}
colocar();

// No messages: boot and shutdown are just the logo
fun sin_mensajes(texto) { }
Plymouth.SetMessageFunction(sin_mensajes);
Plymouth.SetUpdateStatusFunction(sin_mensajes);

// In case a password is ever needed (encrypted disk): dots under the logo
pregunta.sprite = Sprite();
fun pedir(prompt, bullets) {
    t = prompt + "  ";
    i = 0;
    while (i < bullets) { t = t + "•"; i++; }
    pregunta.sprite.SetImage(Image.Text(t, 1, 1, 1));
    pregunta.sprite.SetX(Window.GetX() + Math.Int((Window.GetWidth() - pregunta.sprite.GetImage().GetWidth()) / 2));
    pregunta.sprite.SetY(logo.sprite.GetY() + logo.sprite.GetImage().GetHeight() + 60);
    pregunta.sprite.SetOpacity(1);
}
fun normal() { pregunta.sprite.SetOpacity(0); }
normal();
Plymouth.SetDisplayPasswordFunction(pedir);
Plymouth.SetDisplayNormalFunction(normal);
